---
import type { StatusSource } from '../../../../packages/emdash-ui/src/index'
import { fetchStatus, SiteDetail, StatusBanner } from '../../../../packages/emdash-ui/src/index'

// Demo page for @statusbeam/emdash-ui. The default source is a standalone
// deployment: https://statusbeam.dev, or `STATUSBEAM_BASE_URL` at build time.
// `?source=plugin` reads this site's own StatusBeam plugin routes instead. The
// base URL is never taken from the query string, so the page cannot be used to
// fetch arbitrary URLs.
const STANDALONE_BASE_URL: string = import.meta.env.STATUSBEAM_BASE_URL || 'https://statusbeam.dev'

const usePlugin = Astro.url.searchParams.get('source') === 'plugin'
const source: StatusSource = usePlugin
  ? { baseUrl: Astro.url.origin, flavor: 'emdash' }
  : { baseUrl: STANDALONE_BASE_URL, flavor: 'standalone' }

// One aggregate request feeds both the banner and the per-site list.
const status = await fetchStatus(source)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>StatusBeam components demo</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
      }
      main {
        max-width: 48rem;
        margin: 0 auto;
        padding: 2.5rem 1rem;
        display: grid;
        gap: 1rem;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>StatusBeam components demo</h1>
      <p>Source: <code>{source.baseUrl}</code> ({source.flavor})</p>
      <StatusBanner result={status} />
      {status.ok && status.data.sites.map(site => <SiteDetail {...source} slug={site.slug} />)}
    </main>
  </body>
</html>
