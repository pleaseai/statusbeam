---
import { fetchSite, fetchStatus, SiteDetail, StatusBanner, UnavailableNotice } from '@statusbeam/emdash-ui'
import { renderOptions } from '../block-config'
import { blockFetchOptions, selectFromBlock } from '../block-node'

/**
 * Renders the "status" Portable Text block with the library components. EmDash
 * passes the block data as `Astro.props.node`. Only a development server accepts
 * a localhost or private source (a local fixture); a production build refuses it.
 * The site's `allowedOrigins`, when configured, decide the source instead. The
 * read itself happens here, so it does not follow redirects past those checks.
 */
const selection = selectFromBlock(Astro.props.node ?? {}, renderOptions(import.meta.env.DEV))
const options = blockFetchOptions()
const banner = selection.ok && selection.view === 'banner' ? await fetchStatus(selection.source, options) : undefined
const site = selection.ok && selection.view === 'site' ? await fetchSite(selection.source, selection.slug, options) : undefined
---

{banner && <StatusBanner result={banner} />}
{site && <SiteDetail result={site} />}
{!selection.ok && <UnavailableNotice result={{ ok: false, reason: 'contract', detail: selection.reason, url: '' }} />}
