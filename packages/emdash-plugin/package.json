{
  "name": "@statusbeam/emdash-plugin",
  "type": "module",
  "version": "0.0.0",
  "private": false,
  "description": "StatusBeam engine for EmDash — a native plugin that runs scheduled checks with the core engine.",
  "license": "MIT",
  "homepage": "https://github.com/pleaseai/statusbeam/tree/main/packages/emdash-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pleaseai/statusbeam.git",
    "directory": "packages/emdash-plugin"
  },
  "keywords": [
    "emdash",
    "emdash-plugin",
    "statusbeam",
    "status-page"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./sandbox": "./dist/plugin.mjs"
  },
  "main": "dist/index.mjs",
  "files": [
    "dist",
    "emdash-plugin.jsonc"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "emdash-plugin validate",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:admin": "bun test --preload ./tests/dom-preload.ts ./tests/monitors.dom.tsx ./tests/test-monitor.dom.tsx ./tests/overview.dom.tsx",
    "test:host": "bun test --preload ./tests/host-preload.ts ./tests/engine.host.ts ./tests/public.host.ts ./tests/webhooks.host.ts ./tests/admin.host.ts"
  },
  "peerDependencies": {
    "@cloudflare/kumo": "2.6.0",
    "@emdash-cms/admin": "^1.3.1",
    "react": "^19"
  },
  "dependencies": {
    "yaml": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/kumo": "2.6.0",
    "@emdash-cms/admin": "1.3.1",
    "@emdash-cms/plugin-cli": "0.13.4",
    "@happy-dom/global-registrator": "^21.0.4",
    "@statusbeam/core": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "emdash": "^1.3.1",
    "happy-dom": "^21.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vite": "^8"
  }
}
