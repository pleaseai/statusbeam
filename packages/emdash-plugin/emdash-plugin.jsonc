{
  "$schema": "../../node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

  "slug": "statusbeam",
  // Placeholder until the registry publisher is set up (T012).
  "publisher": "did:plc:statusbeamplaceholder",

  "license": "MIT",
  "author": { "name": "StatusBeam maintainers" },
  "security": { "url": "https://github.com/pleaseai/statusbeam/security" },

  // The engine probes arbitrary user-configured URLs (ADR-0004 Negative consequences).
  "capabilities": ["network:request:unrestricted"],
  "allowedHosts": [],

  // Notification destinations live in encrypted settings, never in the YAML: a webhook URL embeds
  // its credential. The scheduled run reads them with the configuration in one `settings.list`.
  "admin": {
    "settingsSchema": {
      "slackWebhookUrl": {
        "type": "secret",
        "label": "Slack webhook URL",
        "description": "Incoming-webhook URL. Status changes post here."
      },
      "webhookUrls": {
        "type": "secret",
        "label": "Generic webhook URLs",
        "description": "One URL per line, or separated by commas or spaces. Each receives the status-change JSON."
      }
    }
  },

  // One document per (slug, UTC day): `{ slug, date, up, degraded, down, total }`, id `slug:date`.
  // `date` alone serves the retention prune; `[slug, date]` serves one monitor's history.
  "storage": {
    "buckets": { "indexes": ["date", ["slug", "date"]] }
  }
}
