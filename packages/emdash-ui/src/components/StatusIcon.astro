---
import type { Severity } from '@statusbeam/core/contract'

/**
 * Severity icon (Lucide shapes, inlined so the package ships no icon
 * dependency). Decorative: every use sits next to a text label that names the
 * status, so the icon is hidden from assistive tech. The distinct shapes keep
 * the status readable without color (WCAG 1.4.1).
 */
interface Props {
  kind: Severity | 'unavailable' | 'pending'
  size?: number
}

const { kind, size = 20 } = Astro.props
---

<svg
  class="sb-icon"
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {kind === 'operational' && (
    <>
      <circle cx="12" cy="12" r="10" />
      <path d="m9 12 2 2 4-4" />
    </>
  )}
  {(kind === 'degraded' || kind === 'partial_outage') && (
    <>
      <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
      <path d="M12 9v4" />
      <path d="M12 17h.01" />
    </>
  )}
  {kind === 'major_outage' && (
    <>
      <circle cx="12" cy="12" r="10" />
      <path d="m15 9-6 6" />
      <path d="m9 9 6 6" />
    </>
  )}
  {kind === 'maintenance' && (
    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
  )}
  {kind === 'pending' && (
    <>
      <circle cx="12" cy="12" r="10" />
      <path d="M12 6v6l4 2" />
    </>
  )}
  {kind === 'unavailable' && (
    <>
      <circle cx="12" cy="12" r="10" />
      <path d="M8 12h8" />
    </>
  )}
</svg>

<style>
  .sb-icon {
    flex: none;
    color: var(--sb-tone, currentColor);
  }
</style>
