---
import type { DayKey, Locale } from '@statusbeam/core/contract'
import type { SiteInput } from '../client'
import { DEFAULT_LOCALE, formatDay, formatUptime, getDict, uptimeFigure } from '@statusbeam/core/contract'
import { loadSite } from '../client'
import '../styles/tokens.css'
import Unavailable from './Unavailable.astro'

/**
 * 90-day uptime bar timeline for one site. Looks like apps/web's
 * UptimeTimeline: each bar's `title` names the day and its status in text, so
 * no day is conveyed by color alone. For assistive tech the strip is a list
 * named by the 90-day uptime, with the same day text visually hidden in each
 * bar, since a `title` inside an image role is not exposed. Static HTML, no
 * client JS.
 *
 * Pass `baseUrl` + `slug` (plus `flavor` for an EmDash plugin source) to fetch,
 * or a `result` from `fetchSite` to reuse one request.
 */
type Props = SiteInput & { locale?: Locale }

const { locale = DEFAULT_LOCALE, ...input } = Astro.props
const result = await loadSite(input)
const t = getDict(locale)
const history = result.ok ? result.data.history : []
// Named by the same figure SiteDetail shows, so the two never disagree.
const figure = result.ok ? uptimeFigure(result.data) : null
const stripLabel = figure === null ? t.timeline.ariaNoData : t.timeline.ariaUptime(figure)
---

{result.ok
  ? (
      <div class="statusbeam sb-bars">
        {/* `role="list"` keeps the list semantics that some browsers drop once list-style is removed. */}
        <ul class="sb-strip" role="list" aria-label={stripLabel}>
          {history.map((d) => {
            const key: DayKey = d.status ?? 'nodata'
            // Only real (non-nodata) days carry an uptime figure in the tooltip.
            const uptimeSuffix = d.status !== null ? ` · ${formatUptime(d.uptime)}` : ''
            const label = `${formatDay(d.date, locale)} — ${t.day[key]}${uptimeSuffix}`
            return (
              <li class="sb-bar" data-sb-day={key} title={label}>
                <span class="sb-hidden">{label}</span>
              </li>
            )
          })}
        </ul>
        <div class="sb-axis">
          <span>{t.timeline.windowStart(90)}</span>
          <span>{t.timeline.today}</span>
        </div>
      </div>
    )
  : <Unavailable result={result} locale={locale} />}

<style>
  .sb-strip {
    display: flex;
    align-items: stretch;
    gap: 1px;
    height: 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sb-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .sb-bar {
    flex: 1 1 0;
    min-width: 2px;
    border-radius: 1px;
    background: var(--sb-nodata);
    transition: opacity 0.15s;
  }
  .sb-bar:hover {
    opacity: 0.7;
  }
  .sb-bar[data-sb-day='up'] {
    background: var(--sb-operational);
  }
  .sb-bar[data-sb-day='degraded'] {
    background: var(--sb-degraded);
  }
  .sb-bar[data-sb-day='down'] {
    background: var(--sb-major);
  }
  .sb-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.375rem;
    font-size: 0.75rem;
    color: var(--sb-muted);
  }
</style>
